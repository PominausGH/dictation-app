# Maintainer: PominausGH
pkgname=voxtty-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Private, local-first voice dictation for Linux (Alt+D hotkey, on-device Whisper transcription)"
arch=('x86_64')
url="https://voxtty.com"
license=('MIT')
depends=('python' 'ydotool' 'portaudio' 'python-gobject' 'gtk3' 'libnotify' 'libayatana-appindicator')
makedepends=('git' 'python-virtualenv')
provides=('voxtty')
conflicts=('voxtty')
source=("voxtty::git+https://github.com/PominausGH/voxtty.git"
        "voxtty.service")
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd "$srcdir/voxtty"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/voxtty"
  python -m venv --system-site-packages venv
  venv/bin/pip install --upgrade pip
  # webrtcvad imports pkg_resources, which setuptools>=81 no longer bundles.
  venv/bin/pip install 'setuptools<81'

  # openwakeword's tflite-runtime dependency (Linux-only) has no wheels for
  # Python 3.13+, so a plain `pip install -r requirements.txt` fails outright
  # on Arch, which always ships current Python. openwakeword itself falls
  # back to onnxruntime at import time when tflite_runtime is missing (both
  # .tflite and .onnx copies of every model are fetched by
  # openwakeword.utils.download_models()), so install it with --no-deps and
  # supply its other real dependencies by hand.
  grep -v '^openwakeword' requirements.txt > requirements-no-oww.txt
  venv/bin/pip install -r requirements-no-oww.txt
  # Installs the package itself, creating the `voxtty` console script that
  # voxtty.service runs.
  venv/bin/pip install --no-deps .
  venv/bin/pip install --no-deps 'openwakeword>=0.6.0'
  venv/bin/pip install 'onnxruntime>=1.10.0,<2' 'scipy>=1.3,<2' 'scikit-learn>=1,<2' 'requests>=2.0,<3' 'tqdm>=4.0,<5.0'
}

package() {
  install -dm755 "$pkgdir/opt/voxtty"
  cp -r "$srcdir/voxtty/." "$pkgdir/opt/voxtty/"
  rm -rf "$pkgdir/opt/voxtty/.git"

  install -Dm644 "$srcdir/voxtty.service" "$pkgdir/usr/lib/systemd/user/voxtty.service"
  install -Dm644 "$pkgdir/opt/voxtty/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
